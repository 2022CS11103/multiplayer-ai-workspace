DATABASE_URL=sqlite+aiosqlite:///./maw.db
# When Docker is available, switch to:
# DATABASE_URL=postgresql+asyncpg://maw:maw@localhost:5432/maw
# Optional. If Redis is down, the API falls back to in-process WebSocket broadcast.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=72

FRONTEND_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Optional: real agent reasoning. Set ONE key. Without any key, the agent uses the mock LLM.
# LLM_PROVIDER=auto picks the first key present (openai, then xai, then gemini).
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Grok (xAI): https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used when the main model answers 429/503 (overloaded).
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional: any other OpenAI-compatible endpoint (e.g. a proxy). Leave empty for the provider default.
LLM_BASE_URL=
# auto = live if a key is set, else mock | mock | live
LLM_MODE=auto
LLM_TIMEOUT_SECONDS=90
LLM_RETRIES=3
AGENT_STEP_DELAY=0.05

# Risky tools wait this long for an editor. Timeout is default-deny.
APPROVAL_TIMEOUT_SECONDS=300

# Optional: Slack-compatible incoming webhook. Pings when the agent waits for approval,
# when a session is handed to someone, and on @mentions. Empty = in-app inbox only.
NOTIFY_WEBHOOK_URL=

# auto: Docker if installed; otherwise a local subprocess in development (no network isolation)
# and mock in production. mock never runs anything and says so. Tests force mock.
SANDBOX_MODE=auto
# With a live LLM, failing tests get this many rewrite + rerun rounds.
AGENT_FIX_ATTEMPTS=1
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT_SECONDS=20

# Optional: live GitHub tools. Without this, GitHub tools return sandbox fixtures.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Operations ---------------------------------------------------------------
# production refuses to start with the default JWT_SECRET and drops the localhost CORS origin.
ENVIRONMENT=development
LOG_LEVEL=INFO
# json for log collectors (Docker/hosted); text for a terminal.
LOG_FORMAT=text
# Extra allowed browser origins, comma-separated (FRONTEND_URL is always allowed).
CORS_ORIGINS=
# Optional error tracking. Empty = off.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# When set, /metrics requires `Authorization: Bearer <token>`.
METRICS_TOKEN=

# api = agent runs inside the API process (simple local dev).
# worker = API only queues runs; `python -m app.worker` executes them. Needs Redis so
#          the worker's live events reach browsers connected to the API.
AGENT_RUNNER=api
# A worker that stops heartbeating for this long loses its runs to another worker.
WORKER_LEASE_SECONDS=15
WORKER_METRICS_PORT=9100
# true = create tables on startup (dev). Production: false + `alembic upgrade head`.
DB_AUTO_CREATE=true

# Docker image only: seed the demo room on boot (python -m app.seed).
SEED_DEMO=false
DEMO_PASSWORD=forge-demo-2026
