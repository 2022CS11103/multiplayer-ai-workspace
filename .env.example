DATABASE_URL=sqlite+aiosqlite:///./maw.db
# When Docker is available, switch to:
# DATABASE_URL=postgresql+asyncpg://maw:maw@localhost:5432/maw
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=72

FRONTEND_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Optional: real agent reasoning. Without this, the agent runs in demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: live GitHub tools. Without this, GitHub tools return sandbox fixtures.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
